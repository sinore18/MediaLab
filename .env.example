# false uses the local API round-trip and does not call Azure; true enables Blob SAS uploads.
PROD=false

# Azure Blob Storage. Use an account key with permission to create blobs and SAS tokens.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=bleeper-media
AZURE_SAS_EXPIRY_MINUTES=15

# Upload limits enforced by the API as well as the client.
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600

# Processing provider credentials. Configure these when selecting providers.
STT_PROVIDER=
STT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local speech transcription. The selected Whisper model is downloaded on first use.
LOCAL_STT_MODEL=base
LOCAL_STT_DEVICE=cpu
LOCAL_STT_LANGUAGE=en

# torchaudio MMS_FA alignment device.
LOCAL_ALIGNMENT_DEVICE=cpu

# Local development origins.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1